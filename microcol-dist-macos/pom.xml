<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.microcol</groupId>
        <artifactId>microcol-root</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>
    <artifactId>microcol-dist-macos</artifactId>
    <packaging>pom</packaging>
    <name>MicroCol macos distribution</name>

    <!-- The dependency orders the reactor; package with -am to rebuild its runtime. -->
    <dependencies>
        <dependency>
            <groupId>org.microcol</groupId>
            <artifactId>microcol-dist</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <properties>
        <!-- Profiles derive the host label; CI may set microcol.platform only to the matching label. -->
        <expected.platform>unsupported</expected.platform>
        <microcol.platform>${expected.platform}</microcol.platform>
        <dev.assets>${project.build.directory}/dev-assets</dev.assets>
        <dev.asset.basename>MicroCol-${microcol.platform}-${microcol.build.id}</dev.asset.basename>
        <runtime.image>${project.parent.basedir}/microcol-dist/target/dist</runtime.image>
        <!-- jpackage on macOS requires a positive major version; keep game version unchanged.
             Map Maven major N to native bundle major N+1 to preserve version ordering. -->
        <native.app.version>${parsedVersion.nextMajorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</native.app.version>
        <app.image>${project.build.directory}/app-image/MicroCol.app</app.image>
    </properties>

    <profiles>
        <profile>
            <id>native-aarch64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><expected.platform>macos-arm64</expected.platform></properties>
        </profile>
        <profile>
            <id>native-arm64</id>
            <activation><os><family>mac</family><arch>arm64</arch></os></activation>
            <properties><expected.platform>macos-arm64</expected.platform></properties>
        </profile>
        <profile>
            <id>native-x86_64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><expected.platform>macos-x86_64</expected.platform></properties>
        </profile>
    </profiles>

    <build>
        <finalName>MicroCol-${project.version}-macos-${os.arch}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>native-build-host</id><phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration><rules>
                            <requireOS><family>mac</family></requireOS>
                            <requireProperty>
                                <property>microcol.platform</property>
                                <regex>macos-(arm64|x86_64)</regex>
                                <message>Unsupported native platform; use a supported host JDK architecture.</message>
                            </requireProperty>
                            <requireJavaVersion>
                                <version>[17,18)</version>
                                <message>Use JDK 17 (set JAVA_HOME) for native distribution builds.</message>
                            </requireJavaVersion>
                        </rules></configuration>
                    </execution>
                    <execution>
                        <id>linked-runtime-exists</id><phase>prepare-package</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration><rules><requireFilesExist>
                            <files><file>${runtime.image}/bin/java</file></files>
                            <message>Build microcol-dist first: use -am and do not disable its jlink execution.</message>
                        </requireFilesExist></rules></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions><execution>
                    <!-- Native installers require a numeric version, without -SNAPSHOT. -->
                    <id>native-version</id><phase>initialize</phase>
                    <goals><goal>parse-version</goal></goals>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration><executable>${java.home}/bin/jpackage</executable></configuration>
                <executions>
                    <execution>
                        <id>application-image</id><phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration><arguments>
                            <argument>--type</argument><argument>app-image</argument>
                            <argument>--name</argument><argument>MicroCol</argument>
                            <argument>--app-version</argument>
                            <argument>${native.app.version}</argument>
                            <argument>--vendor</argument><argument>MicroCol</argument>
                            <argument>--icon</argument><argument>${project.parent.basedir}/microcol-dist/src/icon.icns</argument>
                            <argument>--runtime-image</argument><argument>${runtime.image}</argument>
                            <argument>--module</argument><argument>microcol.game/org.microcol.MicroCol</argument>
                            <argument>--dest</argument><argument>${project.build.directory}/app-image</argument>
                        </arguments></configuration>
                    </execution>
                    <execution>
                        <id>native-installer</id><phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration><arguments>
                            <argument>--type</argument><argument>dmg</argument>
                            <argument>--name</argument><argument>MicroCol</argument>
                            <!-- jpackage does not inherit installer version/vendor from the application image. -->
                            <argument>--app-version</argument>
                            <argument>${native.app.version}</argument>
                            <argument>--vendor</argument><argument>MicroCol</argument>
                            <argument>--app-image</argument><argument>${app.image}</argument>
                            <argument>--resource-dir</argument><argument>${project.basedir}/src/main/jpackage</argument>
                            <argument>--dest</argument><argument>${project.build.directory}/packages</argument>
                        </arguments></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions><execution>
                    <!-- Maven owns the updater archive, including executable file modes. -->
                    <id>updater-archive</id><phase>package</phase>
                    <goals><goal>single</goal></goals>
                    <configuration>
                        <descriptors><descriptor>src/assembly/updater.xml</descriptor></descriptors>
                        <appendAssemblyId>false</appendAssemblyId>
                        <attach>false</attach>
                        <finalName>${dev.asset.basename}</finalName>
                        <outputDirectory>${dev.assets}</outputDirectory>
                    </configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>validate-release-labels</id><phase>validate</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <fail message="microcol.platform must match this host's JDK architecture (${expected.platform}).">
                                <condition><not><equals arg1="${microcol.platform}" arg2="${expected.platform}"/></not></condition>
                            </fail>
                            <fail message="microcol.build.id must be local or dev-RUNNUMBER-12LOWERCASEHEX.">
                                <condition><not><matches string="${microcol.build.id}" pattern="^(local|dev-[1-9][0-9]*-[0-9a-f]{12})$"/></not></condition>
                            </fail>
                        </target></configuration>
                    </execution>
                    <execution>
                        <id>clear-generated-packages</id><phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <!-- Repeated package runs must not retain a previous release's assets. -->
                            <delete dir="${project.build.directory}/app-image"/>
                            <delete dir="${project.build.directory}/packages"/>
                            <delete dir="${dev.assets}"/>
                            <mkdir dir="${project.build.directory}/packages"/>
                            <mkdir dir="${dev.assets}"/>
                        </target></configuration>
                    </execution>
                    <execution>
                        <id>release-assets-and-checksums</id><phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <!-- Fail the build if an updater image contains links or special files.
                                 The updater accepts only regular files and directories. -->
                            <fail message="Updater application image contains a symbolic link or special file.">
                                <condition><not><resourcecount count="0"><union>
                                    <fileset dir="${app.image}"><or><symlink/><not><type type="file"/></not></or></fileset>
                                    <dirset dir="${app.image}"><symlink/></dirset>
                                </union></resourcecount></not></condition>
                            </fail>
                            <copy file="${project.build.directory}/packages/MicroCol-${native.app.version}.dmg"
                                  tofile="${dev.assets}/${dev.asset.basename}.dmg"/>
                            <!-- Raw SHA-256 plus newline; publishing verifies these without repacking assets. -->
                            <checksum algorithm="SHA-256" fileext=".sha256" format="CHECKSUM" forceOverwrite="yes">
                                <fileset dir="${dev.assets}" includes="${dev.asset.basename}.zip,${dev.asset.basename}.dmg"/>
                            </checksum>
                        </target></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
