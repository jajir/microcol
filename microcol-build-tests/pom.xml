<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.microcol</groupId>
        <artifactId>microcol-root</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>
    <artifactId>microcol-build-tests</artifactId>
    <name>MicroCol build verification</name>
    <description>Launcher, publication and native distribution acceptance checks.</description>

    <properties>
        <microcol.skipNativeTests>true</microcol.skipNativeTests>
        <microcol.platform></microcol.platform>
    </properties>
    <dependencies>
        <!-- Order the reactor without putting a packaged application on the test classpath. -->
        <dependency>
            <groupId>org.microcol</groupId><artifactId>microcol-launcher</artifactId>
            <version>${project.version}</version><type>pom</type><scope>test</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId>
            <version>1.28.0</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <includes><include>**/*Test.java</include></includes>
                    <systemPropertyVariables>
                        <microcol.root>${project.basedir}/..</microcol.root>
                        <microcol.test.output>${project.build.directory}</microcol.test.output>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <microcol.root>${project.basedir}/..</microcol.root>
                        <microcol.test.output>${project.build.directory}</microcol.test.output>
                        <microcol.platform>${microcol.platform}</microcol.platform>
                        <microcol.build.id>${microcol.build.id}</microcol.build.id>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>launcher-packages</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <includes><include>**/LauncherPackageIT.java</include></includes>
                            <summaryFile>${project.build.directory}/failsafe-reports/launcher-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native-distribution</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        <configuration>
                            <skipITs>${microcol.skipNativeTests}</skipITs>
                            <includes><include>**/NativeDistributionIT.java</include></includes>
                            <summaryFile>${project.build.directory}/failsafe-reports/native-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>verify-macos</id>
            <properties><microcol.skipNativeTests>false</microcol.skipNativeTests></properties>
            <dependencies><dependency>
                <groupId>org.microcol</groupId><artifactId>microcol-dist-macos</artifactId>
                <version>${project.version}</version><type>pom</type><scope>test</scope>
                <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
            </dependency></dependencies>
        </profile>
        <profile>
            <id>verify-linux</id>
            <properties><microcol.skipNativeTests>false</microcol.skipNativeTests></properties>
            <dependencies><dependency>
                <groupId>org.microcol</groupId><artifactId>microcol-dist-linux</artifactId>
                <version>${project.version}</version><type>pom</type><scope>test</scope>
                <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
            </dependency></dependencies>
        </profile>
    </profiles>
</project>
